{
  "schema_version": "ordin.command_card.v1",
  "command": "curl",
  "summary": "Transfer data from or to a URL.",
  "aliases": ["http request", "download url", "fetch url"],
  "intents": ["download a url", "make an http request", "check an endpoint", "fetch a web page"],
  "default_risk": "medium",
  "risk_tags": ["network_access", "remote_content"],
  "effects": [{"effect": "network.download", "resource": "network.remote"}],
  "flags": {
    "-T": {
      "aliases": ["--upload-file"],
      "effects": [{"effect": "network.upload", "resource": "network.remote"}]
    },
    "-d": {
      "aliases": ["--data", "--data-binary", "--data-raw", "--data-urlencode"],
      "effects": [{"effect": "network.upload", "resource": "network.remote"}]
    },
    "-o": {
      "aliases": ["--output"],
      "effects": [{"effect": "filesystem.write", "resource": "filesystem.target"}]
    }
  },
  "examples": [{"command": "curl -I https://example.com", "explanation": "Fetch only response headers."}],
  "templates": [{"command": "curl -I {url}", "description": "Fetch response headers for a URL."}]
}
