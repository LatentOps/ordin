{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-broker-preparation.v1.schema.json",
  "title": "swarm_broker_preparation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "disposition",
    "reason_codes",
    "action_digest",
    "caller_digest",
    "policy_digest",
    "authorization_digest",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_broker_preparation.v1"
    },
    "disposition": {
      "enum": [
        "execute",
        "escalate",
        "deny"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "maxItems": 128,
      "uniqueItems": true
    },
    "action_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "caller_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorization_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_authority": {
      "const": false
    }
  }
}
