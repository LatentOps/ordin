{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-risk-signal.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signal_class",
    "evidence_pointers",
    "confidence",
    "uncertainty",
    "reported_cost_micros",
    "budget",
    "evidence_class",
    "execution_authority",
    "verified_effects"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_risk_signal.v1"
    },
    "signal_class": {
      "enum": [
        "none",
        "unknown",
        "prompt_injection",
        "policy_persuasion",
        "task_redirection",
        "collusive_coordination",
        "evasive_retry",
        "coordinated_plan_change"
      ]
    },
    "evidence_pointers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "maxItems": 16,
      "uniqueItems": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "uncertainty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reported_cost_micros": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_ms",
        "cost_micros"
      ],
      "properties": {
        "time_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cost_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "evidence_class": {
      "const": "behavioral_inference"
    },
    "execution_authority": {
      "const": false
    },
    "verified_effects": {
      "const": false
    }
  }
}
