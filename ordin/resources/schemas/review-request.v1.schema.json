{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latentops.dev/schemas/ordin/review-request.v1.schema.json",
  "title": "Ordin Review Request v1",
  "type": "object",
  "required": ["schema_version", "command", "intent", "context"],
  "properties": {
    "schema_version": {"const": "ordin.review_request.v1"},
    "command": {"type": "string", "minLength": 1},
    "intent": {"type": ["string", "null"]},
    "context": {"type": ["object", "null"], "properties": {"cwd": {"type": ["string", "null"]}, "shell": {"type": ["string", "null"]}, "euid": {"type": ["integer", "null"], "minimum": 0}, "interactive": {"type": ["boolean", "null"]}, "repo_root": {"type": ["string", "null"]}, "agent": {"type": ["string", "null"]}}, "additionalProperties": false},
    "trace": {"type": ["object", "null"], "properties": {"schema_version": {"const": "ordin.action_trace.v1"}, "actions": {"type": "array", "items": {"type": "object", "required": ["command"], "properties": {"command": {"type": "string", "minLength": 1}}, "additionalProperties": false}}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
