{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latentops.dev/schemas/commandgraph/search-result.v1.schema.json",
  "title": "CommandGraph Search Result v1",
  "type": "object",
  "required": ["schema_version", "command", "summary", "score", "why", "example", "risk", "matched_terms", "suggested_commands"],
  "properties": {
    "schema_version": {"const": "commandgraph.search_result.v1"},
    "command": {"type": "string"},
    "summary": {"type": "string"},
    "score": {"type": "number"},
    "why": {"type": "string"},
    "example": {"type": ["string", "null"]},
    "risk": {"type": "string"},
    "matched_terms": {"type": "array", "items": {"type": "string"}},
    "suggested_commands": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
