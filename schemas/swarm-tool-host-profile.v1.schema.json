{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-tool-host-profile.v1.schema.json",
  "title": "Explicit private managed tool host profile",
  "description": "Operator configuration data only. Loading JSON never establishes actor identity, approval, an execution permit, or installed containment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "tenant_id",
    "swarm_id",
    "task_id",
    "workspace",
    "files",
    "actors",
    "http_routes",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_tool_host_profile.v1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "swarm_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "label"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "label": {
            "enum": [
              "public",
              "private_code",
              "secret",
              "pii",
              "unclassified"
            ]
          }
        }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "read_files",
          "write_files",
          "http_routes",
          "peers"
        ],
        "properties": {
          "agent_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "read_files": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]+$"
            }
          },
          "write_files": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.-]+$"
            }
          },
          "http_routes": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            }
          },
          "test_ids": {
            "type": "array", "maxItems": 16, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"}
          },
          "peers": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            }
          }
        }
      }
    },
    "http_routes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "url",
          "addresses",
          "allow_private_network",
          "allow_http",
          "response_limit_bytes",
          "response_label",
          "credential_file",
          "ca_file"
        ],
        "properties": {
          "route_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "addresses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 45
            }
          },
          "allow_private_network": {
            "type": "boolean"
          },
          "allow_http": {
            "type": "boolean"
          },
          "response_limit_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "credential_file": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            ]
          },
          "ca_file": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            ]
          },
          "response_label": {
            "enum": [
              "public",
              "private_code",
              "secret",
              "pii",
              "unclassified"
            ]
          }
        }
      }
    },
    "test_runtime": {"const": "state/test-runtime"},
    "test_routes": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["test_id", "selectors"],
        "properties": {
          "test_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
          "selectors": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 256}}
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "output_bytes",
        "concurrency",
        "lifetime_seconds"
      ],
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "lifetime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    }
  }
}
