{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-executor-outcome.v1.schema.json",
  "title": "swarm_executor_outcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "backend",
    "status",
    "reason_code",
    "action_digest",
    "contract_digest",
    "policy_digest",
    "physical_enforcement",
    "evidence_digest",
    "stdout_bytes",
    "payload_bytes",
    "payload_digest",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_executor_outcome.v1"
    },
    "backend": {
      "enum": ["linux-owned-file-read-v1", "linux-owned-tools-v1", "linux-confined-test-v1"]
    },
    "status": {
      "enum": [
        "completed",
        "denied",
        "unsupported",
        "unknown",
        "canceled"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "action_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "physical_enforcement": {
      "type": "boolean"
    },
    "evidence_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stdout_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "payload_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "payload_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_authority": {
      "const": false
    }
  }
}
