{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latentops.dev/schemas/ordin/tool-semantics.v1.schema.json",
  "title": "Ordin Tool Semantics v1",
  "type": "object",
  "required": ["schema_version", "registry_id", "version", "rules"],
  "properties": {
    "schema_version": {"const": "ordin.tool_semantics.v1"},
    "registry_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "version": {"type": "string", "minLength": 1, "maxLength": 256},
    "rules": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["id", "kind", "tool", "effects", "resources"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 256},
          "kind": {"enum": ["tool", "mcp"]},
          "runtime": {"type": "string", "minLength": 1, "maxLength": 256},
          "server": {"type": "string", "minLength": 1, "maxLength": 256},
          "tool": {"type": "string", "minLength": 1, "maxLength": 256},
          "effects": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {"type": "string", "minLength": 1, "maxLength": 256}
          },
          "resources": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": ["argument", "type"],
              "properties": {
                "argument": {"type": "string", "minLength": 1, "maxLength": 512},
                "type": {"type": "string", "minLength": 1, "maxLength": 256}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
