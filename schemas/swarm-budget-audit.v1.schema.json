{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-budget-audit.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reservations",
    "next_offset",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_budget_audit.v1"
    },
    "reservations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reservation_id",
          "action_digest",
          "context_digest",
          "policy_epoch",
          "status",
          "expires_at"
        ],
        "properties": {
          "reservation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}(?![\\s\\S])",
            "maxLength": 32
          },
          "action_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
            "maxLength": 64
          },
          "context_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
            "maxLength": 64
          },
          "policy_epoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "status": {
            "enum": [
              "reserved",
              "forwarding",
              "uncertain",
              "committed",
              "released",
              "canceled",
              "expired",
              "overrun"
            ]
          },
          "expires_at": {
            "type": "number",
            "minimum": 0,
            "maximum": 1e+18
          }
        }
      }
    },
    "next_offset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 16384
    },
    "execution_authority": {
      "const": false
    }
  }
}
