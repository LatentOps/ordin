{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-coordinator-offline.v1.schema.json",
  "title": "swarm_coordinator_offline",
  "description": "Bounded data-only optional coordinator metadata. JSON never authenticates a producer or restores live authority.",
  "$comment": "Transport canonical JSON is bounded to 65536 UTF-8 bytes, depth 32. Durable projections are bounded to 8MiB and never restore original grants/receipts. Runtime checks enforce exact channel, lease, epoch and scope bindings.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 7,
  "required": [
    "schema_version",
    "scope_digest",
    "online",
    "coverage",
    "requires_online_authority",
    "physical_enforcement",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_coordinator_offline.v1"
    },
    "scope_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "online": {
      "const": false
    },
    "coverage": {
      "const": "unknown"
    },
    "requires_online_authority": {
      "const": true
    },
    "physical_enforcement": {
      "const": false
    },
    "execution_authority": {
      "const": false
    }
  }
}
