{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-coordinator-fence.v1.schema.json",
  "title": "swarm_coordinator_fence",
  "description": "Bounded data-only optional coordinator metadata. JSON never authenticates a producer or restores live authority.",
  "$comment": "Transport canonical JSON is bounded to 65536 UTF-8 bytes, depth 32. Durable projections are bounded to 8MiB and never restore original grants/receipts. Runtime checks enforce exact channel, lease, epoch and scope bindings.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 8,
  "required": [
    "schema_version",
    "scope_digest",
    "revocation_epoch",
    "intent_digest",
    "policy_epoch",
    "owner_fence",
    "execution_authority",
    "physical_enforcement"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_coordinator_fence.v1"
    },
    "scope_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "revocation_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "intent_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "owner_fence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "execution_authority": {
      "const": false
    },
    "physical_enforcement": {
      "const": false
    }
  }
}
