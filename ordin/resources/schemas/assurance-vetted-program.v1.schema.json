{
  "$id": "https://latentops.space/ordin/schemas/assurance-vetted-program.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "maxProperties": 5,
  "properties": {
    "predicate": {
      "const": "synthetic_path_boundary",
      "type": "string"
    },
    "program_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "repository": {
      "additionalProperties": false,
      "maxProperties": 2,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "ordin.assurance_vetted_program.v1",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "maxProperties": 5,
      "properties": {
        "content_digest": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "line": {
          "maximum": 10000000,
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "line",
        "revision",
        "content_digest",
        "symbol"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "repository",
    "source",
    "program_digest",
    "predicate"
  ],
  "title": "Ordin assurance vetted program v1",
  "type": "object"
}
