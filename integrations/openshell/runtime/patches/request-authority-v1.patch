@@ -0,0 +1,418 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Value-blind request commitments shared with Ordin. Never log payload values.
+
+use serde::de::{self, Deserializer, MapAccess, SeqAccess, Visitor};
+use serde::{Deserialize, Serialize};
+use serde_json::value::RawValue;
+use sha2::{Digest, Sha256};
+use std::collections::{BTreeMap, BTreeSet};
+use std::fmt;
+
+pub const ALGORITHM: &str = "ordin.authority-json.sha256.v1";
+
+/// Endpoint authority is the intersection of coarse protocol rules and these
+/// exact authority commitments. No raw argument material is retained.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RequestIntegrity {
+    pub algorithm: String,
+    pub commitments: Vec<String>,
+}
+
+impl RequestIntegrity {
+    pub fn validate(&self, protocol: &str, tls: &str) -> Result<(), InvalidCommitment> {
+        if self.algorithm != ALGORITHM
+            || !matches!(protocol, "graphql" | "mcp" | "json-rpc")
+            || tls == "skip"
+            || self.commitments.is_empty()
+            || self.commitments.len() > MAX_ITEMS
+            || self.commitments.iter().any(|value| {
+                value.len() != 64
+                    || !value
+                        .bytes()
+                        .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+            })
+            || self.commitments.iter().collect::<BTreeSet<_>>().len() != self.commitments.len()
+        {
+            return Err(InvalidCommitment);
+        }
+        Ok(())
+    }
+
+    pub fn allows(&self, protocol: &str, body: &[u8]) -> bool {
+        if self.validate(protocol, "").is_err() {
+            return false;
+        }
+        let result = if protocol == "graphql" {
+            commitment_json(body)
+        } else {
+            rpc_commitment_json(body)
+        };
+        result.is_ok_and(|value| self.commitments.contains(&value))
+    }
+}
+const MAX_BYTES: usize = 1_048_576;
+const MAX_NODES: usize = 4096;
+const MAX_DEPTH: usize = 32;
+const MAX_ITEMS: usize = 128;
+const MAX_TEXT: usize = 65_536;
+const MAX_DIGITS: usize = 1024;
+const MAX_EXPONENT: i32 = 10_000;
+
+fn decimal_token(value: &str) -> Result<String, InvalidCommitment> {
+    let (sign, unsigned) = value.strip_prefix('-').map_or((0, value), |v| (1, v));
+    let (mantissa, exponent) =
+        unsigned
+            .split_once(['e', 'E'])
+            .map_or(Ok((unsigned, 0)), |(m, e)| {
+                e.parse::<i32>()
+                    .map(|e| (m, e))
+                    .map_err(|_| InvalidCommitment)
+            })?;
+    let fraction = mantissa.split_once('.').map_or(0, |(_, f)| f.len());
+    let digits = mantissa.replace('.', "");
+    if digits.trim_start_matches('0').len() > MAX_DIGITS
+        || exponent.unsigned_abs() > MAX_EXPONENT as u32
+    {
+        return Err(InvalidCommitment);
+    }
+    let mut exponent = exponent
+        .checked_sub(i32::try_from(fraction).map_err(|_| InvalidCommitment)?)
+        .ok_or(InvalidCommitment)?;
+    if exponent.unsigned_abs() > MAX_EXPONENT as u32 {
+        return Err(InvalidCommitment);
+    }
+    let mut coefficient = digits.trim_start_matches('0').to_owned();
+    if coefficient.is_empty() {
+        coefficient.push('0');
+        exponent = 0;
+    } else {
+        while coefficient.ends_with('0') {
+            coefficient.pop();
+            exponent += 1;
+        }
+    }
+    if exponent.unsigned_abs() > MAX_EXPONENT as u32 {
+        return Err(InvalidCommitment);
+    }
+    Ok(format!("d{sign}:{coefficient}:{exponent};"))
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct InvalidCommitment;
+
+impl fmt::Display for InvalidCommitment {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("request_commitment_invalid")
+    }
+}
+
+impl std::error::Error for InvalidCommitment {}
+
+struct RawObject(BTreeMap<String, Box<RawValue>>);
+
+impl<'de> Deserialize<'de> for RawObject {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct ObjectVisitor;
+        impl<'de> Visitor<'de> for ObjectVisitor {
+            type Value = RawObject;
+            fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+                formatter.write_str("a bounded unique-key object")
+            }
+            fn visit_map<M: MapAccess<'de>>(self, mut map: M) -> Result<Self::Value, M::Error> {
+                let mut values = BTreeMap::new();
+                while let Some(key) = map.next_key::<String>()? {
+                    if key.len() > MAX_TEXT
+                        || values.len() >= MAX_ITEMS
+                        || values.contains_key(&key)
+                    {
+                        return Err(de::Error::custom("request_commitment_invalid"));
+                    }
+                    let value = map.next_value::<Box<RawValue>>()?;
+                    values.insert(key, value);
+                }
+                Ok(RawObject(values))
+            }
+        }
+        deserializer.deserialize_map(ObjectVisitor)
+    }
+}
+
+struct RawArray(Vec<Box<RawValue>>);
+
+impl<'de> Deserialize<'de> for RawArray {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct ArrayVisitor;
+        impl<'de> Visitor<'de> for ArrayVisitor {
+            type Value = RawArray;
+            fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+                formatter.write_str("a bounded array")
+            }
+            fn visit_seq<S: SeqAccess<'de>>(
+                self,
+                mut sequence: S,
+            ) -> Result<Self::Value, S::Error> {
+                let mut values = Vec::new();
+                while let Some(value) = sequence.next_element::<Box<RawValue>>()? {
+                    if values.len() >= MAX_ITEMS {
+                        return Err(de::Error::custom("request_commitment_invalid"));
+                    }
+                    values.push(value);
+                }
+                Ok(RawArray(values))
+            }
+        }
+        deserializer.deserialize_seq(ArrayVisitor)
+    }
+}
+
+struct Encoder {
+    hasher: Sha256,
+    bytes: usize,
+    nodes: usize,
+}
+
+impl Encoder {
+    fn new() -> Self {
+        let mut hasher = Sha256::new();
+        hasher.update(b"ordin.authority-json.v1\0");
+        Self {
+            hasher,
+            bytes: 0,
+            nodes: 0,
+        }
+    }
+
+    fn write(&mut self, value: &[u8]) -> Result<(), InvalidCommitment> {
+        self.bytes += value.len();
+        if self.bytes > MAX_BYTES {
+            return Err(InvalidCommitment);
+        }
+        self.hasher.update(value);
+        Ok(())
+    }
+
+    fn string(&mut self, value: &str) -> Result<(), InvalidCommitment> {
+        if value.len() > MAX_TEXT {
+            return Err(InvalidCommitment);
+        }
+        self.write(format!("s{}:", value.len()).as_bytes())?;
+        self.write(value.as_bytes())
+    }
+
+    fn walk(&mut self, raw: &RawValue, depth: usize) -> Result<(), InvalidCommitment> {
+        self.nodes += 1;
+        if self.nodes > MAX_NODES || depth > MAX_DEPTH {
+            return Err(InvalidCommitment);
+        }
+        let value = raw.get();
+        match value.as_bytes().first() {
+            Some(b'n') => self.write(b"n"),
+            Some(b't') => self.write(b"t"),
+            Some(b'f') => self.write(b"f"),
+            Some(b'"') => {
+                let decoded: String = serde_json::from_str(value).map_err(|_| InvalidCommitment)?;
+                self.string(&decoded)
+            }
+            Some(b'[') => {
+                let RawArray(items) = serde_json::from_str(value).map_err(|_| InvalidCommitment)?;
+                self.write(format!("l{}:", items.len()).as_bytes())?;
+                for item in items {
+                    self.walk(&item, depth + 1)?;
+                }
+                self.write(b";")
+            }
+            Some(b'{') => {
+                let RawObject(items) =
+                    serde_json::from_str(value).map_err(|_| InvalidCommitment)?;
+                self.write(format!("o{}:", items.len()).as_bytes())?;
+                for (key, item) in items {
+                    self.nodes += 1;
+                    if self.nodes > MAX_NODES || depth + 1 > MAX_DEPTH {
+                        return Err(InvalidCommitment);
+                    }
+                    self.string(&key)?;
+                    self.walk(&item, depth + 1)?;
+                }
+                self.write(b";")
+            }
+            Some(_) if value.contains(['.', 'e', 'E']) => {
+                self.write(decimal_token(value)?.as_bytes())
+            }
+            Some(_) => {
+                if value.trim_start_matches('-').len() > MAX_DIGITS {
+                    return Err(InvalidCommitment);
+                }
+                self.write(b"i")?;
+                self.write(if value == "-0" {
+                    b"0"
+                } else {
+                    value.as_bytes()
+                })?;
+                self.write(b";")
+            }
+            None => Err(InvalidCommitment),
+        }
+    }
+
+    fn finish(self) -> String {
+        format!("{:x}", self.hasher.finalize())
+    }
+}
+
+pub fn commitment_json(body: &[u8]) -> Result<String, InvalidCommitment> {
+    if body.len() > MAX_BYTES {
+        return Err(InvalidCommitment);
+    }
+    let raw: Box<RawValue> = serde_json::from_slice(body).map_err(|_| InvalidCommitment)?;
+    let mut encoder = Encoder::new();
+    encoder.walk(&raw, 0)?;
+    Ok(encoder.finish())
+}
+
+pub fn rpc_commitment_json(body: &[u8]) -> Result<String, InvalidCommitment> {
+    // Validate the complete envelope first, including bounded correlation IDs
+    // and duplicate decoded keys in material omitted from authority projection.
+    commitment_json(body)?;
+    let raw: Box<RawValue> = serde_json::from_slice(body).map_err(|_| InvalidCommitment)?;
+    let projection = if raw.get().starts_with('[') {
+        let RawArray(messages) = serde_json::from_str(raw.get()).map_err(|_| InvalidCommitment)?;
+        if messages.is_empty() {
+            return Err(InvalidCommitment);
+        }
+        let projections = messages
+            .into_iter()
+            .map(|message| rpc_projection(&message))
+            .collect::<Result<Vec<_>, _>>()?;
+        serde_json::value::to_raw_value(&projections).map_err(|_| InvalidCommitment)?
+    } else {
+        rpc_projection(&raw)?
+    };
+    let mut encoder = Encoder::new();
+    encoder.walk(&projection, 0)?;
+    Ok(encoder.finish())
+}
+
+fn rpc_projection(raw: &RawValue) -> Result<Box<RawValue>, InvalidCommitment> {
+    let RawObject(mut message) = serde_json::from_str(raw.get()).map_err(|_| InvalidCommitment)?;
+    let allowed = BTreeSet::from(["jsonrpc", "id", "method", "params"]);
+    if message.keys().any(|key| !allowed.contains(key.as_str())) {
+        return Err(InvalidCommitment);
+    }
+    let version: String =
+        serde_json::from_str(message.remove("jsonrpc").ok_or(InvalidCommitment)?.get())
+            .map_err(|_| InvalidCommitment)?;
+    if version != "2.0" {
+        return Err(InvalidCommitment);
+    }
+    let method = message.remove("method").ok_or(InvalidCommitment)?;
+    let name: String = serde_json::from_str(method.get()).map_err(|_| InvalidCommitment)?;
+    if name.is_empty()
+        || name.chars().count() > 128
+        || name.chars().any(|c| c <= ' ' || c == '\u{7f}' || c == '*')
+    {
+        return Err(InvalidCommitment);
+    }
+    let kind = if let Some(id) = message.remove("id") {
+        if !matches!(
+            id.get().as_bytes().first(),
+            Some(b'"' | b'n' | b'-' | b'0'..=b'9')
+        ) {
+            return Err(InvalidCommitment);
+        }
+        "request"
+    } else {
+        "notification"
+    };
+    let mut projection = BTreeMap::new();
+    projection.insert(
+        "kind",
+        serde_json::value::to_raw_value(kind).map_err(|_| InvalidCommitment)?,
+    );
+    projection.insert("method", method);
+    if let Some(params) = message.remove("params") {
+        if !matches!(params.get().as_bytes().first(), Some(b'{' | b'[' | b'n')) {
+            return Err(InvalidCommitment);
+        }
+        projection.insert("params", params);
+    }
+    serde_json::value::to_raw_value(&projection).map_err(|_| InvalidCommitment)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn portable_python_vectors_match_runtime_commitments() {
+        let vectors: Vec<serde_json::Value> =
+            serde_json::from_str(include_str!("../test-vectors.json")).unwrap();
+        for vector in vectors {
+            let body = vector["json"].as_str().unwrap().as_bytes();
+            let actual = if vector["kind"] == "json" {
+                commitment_json(body)
+            } else {
+                rpc_commitment_json(body)
+            };
+            assert_eq!(actual.unwrap(), vector["digest"].as_str().unwrap());
+        }
+    }
+
+    #[test]
+    fn duplicate_keys_and_invalid_payloads_fail_closed() {
+        for input in [
+            r#"{"x":1,"x":2}"#,
+            r#"{"nested":{"x":1,"x":2}}"#,
+            r#"{"a":1,"\u0061":2}"#,
+            "NaN",
+            "1e10001",
+            r#""\ud800""#,
+        ] {
+            assert_eq!(commitment_json(input.as_bytes()), Err(InvalidCommitment));
+        }
+    }
+
+    #[test]
+    fn decimals_preserve_exact_authority() {
+        for (a, b) in [
+            ("9007199254740992.0", "9007199254740993.0"),
+            ("0.0", "1e-4000"),
+            ("0.1", "0.10000000000000000000000000001"),
+        ] {
+            assert_ne!(commitment_json(a.as_bytes()), commitment_json(b.as_bytes()));
+        }
+        assert_eq!(commitment_json(b"1.00"), commitment_json(b"10e-1"));
+        assert_eq!(commitment_json(b"-0"), commitment_json(b"0"));
+    }
+
+    #[test]
+    fn reordered_maps_preserve_commitments_but_values_and_types_do_not() {
+        assert_eq!(
+            commitment_json(br#"{"a":1,"b":[null,true]}"#),
+            commitment_json(br#"{"b":[null,true],"a":1}"#)
+        );
+        assert_ne!(commitment_json(b"1"), commitment_json(b"1.0"));
+        assert_ne!(commitment_json(b"0.0"), commitment_json(b"-0.0"));
+        assert_ne!(
+            commitment_json(br#"{"path":"/a"}"#),
+            commitment_json(br#"{"path":"/b"}"#)
+        );
+    }
+
+    #[test]
+    fn rpc_kind_and_params_presence_remain_bound() {
+        let first = br#"{"jsonrpc":"2.0","id":1,"method":"ping","params":{}}"#;
+        let second = br#"{"jsonrpc":"2.0","id":"another","method":"ping","params":{}}"#;
+        assert_eq!(rpc_commitment_json(first), rpc_commitment_json(second));
+        assert_ne!(
+            rpc_commitment_json(first),
+            rpc_commitment_json(br#"{"jsonrpc":"2.0","method":"ping","params":{}}"#)
+        );
+        assert_ne!(
+            rpc_commitment_json(br#"{"jsonrpc":"2.0","id":1,"method":"ping"}"#),
+            rpc_commitment_json(br#"{"jsonrpc":"2.0","id":1,"method":"ping","params":null}"#)
+        );
+    }
+}
