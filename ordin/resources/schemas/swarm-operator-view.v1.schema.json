{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-operator-view.v1.schema.json",
  "title": "swarm_operator_view",
  "description": "Privacy-default diagnostic data; never identity, permission or runtime authority. External anchor trust is independent of local history ownership.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 6,
  "required": [
    "schema_version",
    "scope_ref",
    "view",
    "data",
    "proof_gaps",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_operator_view.v1"
    },
    "scope_ref": {
      "type": "string",
      "minLength": 69,
      "maxLength": 69,
      "pattern": "^hmac:[a-f0-9]{64}$"
    },
    "view": {
      "enum": [
        "graph",
        "incidents",
        "policy",
        "coverage"
      ]
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 4,
          "required": [
            "nodes",
            "edges",
            "paths",
            "successful_exploitation"
          ],
          "properties": {
            "nodes": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "maxProperties": 5,
                "required": [
                  "event_ref",
                  "actor_ref",
                  "kind",
                  "action_ref",
                  "evidence"
                ],
                "properties": {
                  "event_ref": {
                    "type": "string",
                    "minLength": 69,
                    "maxLength": 69,
                    "pattern": "^hmac:[a-f0-9]{64}$"
                  },
                  "actor_ref": {
                    "type": "string",
                    "minLength": 69,
                    "maxLength": 69,
                    "pattern": "^hmac:[a-f0-9]{64}$"
                  },
                  "kind": {
                    "enum": [
                      "artifact_read",
                      "artifact_write",
                      "canceled",
                      "committed",
                      "completed",
                      "delegated",
                      "denied",
                      "failed",
                      "forwarded",
                      "message_received",
                      "message_sent",
                      "observed",
                      "proposed",
                      "reserved",
                      "reviewed",
                      "revoked"
                    ]
                  },
                  "action_ref": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 69,
                        "maxLength": 69,
                        "pattern": "^hmac:[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "evidence": {
                    "enum": [
                      "reported",
                      "diagnostic"
                    ]
                  }
                }
              }
            },
            "edges": {
              "type": "array",
              "maxItems": 1024,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "maxProperties": 3,
                "required": [
                  "from_ref",
                  "to_ref",
                  "state"
                ],
                "properties": {
                  "from_ref": {
                    "type": "string",
                    "minLength": 69,
                    "maxLength": 69,
                    "pattern": "^hmac:[a-f0-9]{64}$"
                  },
                  "to_ref": {
                    "type": "string",
                    "minLength": 69,
                    "maxLength": 69,
                    "pattern": "^hmac:[a-f0-9]{64}$"
                  },
                  "state": {
                    "enum": [
                      "known",
                      "missing_parent"
                    ]
                  }
                }
              }
            },
            "paths": {
              "type": "array",
              "maxItems": 0
            },
            "successful_exploitation": {
              "const": "unknown"
            }
          }
        },
        {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 12,
            "required": [
              "incident_ref",
              "scope_ref",
              "operation",
              "revocation_epoch",
              "affected_count",
              "notifications_complete",
              "resumed",
              "outcomes",
              "freshness",
              "proof_gaps",
              "chain_ref",
              "execution_authority"
            ],
            "properties": {
              "incident_ref": {
                "type": "string",
                "minLength": 69,
                "maxLength": 69,
                "pattern": "^hmac:[a-f0-9]{64}$"
              },
              "scope_ref": {
                "type": "string",
                "minLength": 69,
                "maxLength": 69,
                "pattern": "^hmac:[a-f0-9]{64}$"
              },
              "operation": {
                "enum": [
                  "pause",
                  "revoke",
                  "quarantine",
                  "unknown"
                ]
              },
              "revocation_epoch": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "affected_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "notifications_complete": {
                "type": "boolean"
              },
              "resumed": {
                "type": "boolean"
              },
              "outcomes": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "enum": [
                    "canceled",
                    "completed",
                    "unable_to_stop",
                    "unknown"
                  ]
                }
              },
              "freshness": {
                "enum": [
                  "last_recorded",
                  "durable_metadata"
                ]
              },
              "proof_gaps": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "enum": [
                    "unmediated_paths_uncovered",
                    "prehistory_unknown",
                    "coordinator_unavailable",
                    "durable_history_incomplete",
                    "capture_unavailable",
                    "projection_truncated",
                    "capture_pending_or_unavailable",
                    "capture_overflow",
                    "policy_snapshot_stale",
                    "route_inventory_missing",
                    "no_current_runtime_attestation",
                    "source_unavailable"
                  ]
                }
              },
              "chain_ref": {
                "type": "string",
                "minLength": 69,
                "maxLength": 69,
                "pattern": "^hmac:[a-f0-9]{64}$"
              },
              "execution_authority": {
                "const": false
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 5,
          "required": [
            "policy_ref",
            "policy_epoch",
            "owner_fence",
            "claim",
            "budget_configured"
          ],
          "properties": {
            "policy_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 69,
                  "maxLength": 69,
                  "pattern": "^hmac:[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "policy_epoch": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "owner_fence": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "claim": {
              "const": "committed_metadata_not_permission"
            },
            "budget_configured": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "maxProperties": 4,
                "required": [
                  "scope",
                  "metric",
                  "maximum",
                  "subject_ref"
                ],
                "properties": {
                  "scope": {
                    "enum": [
                      "tenant",
                      "swarm",
                      "agent",
                      "task",
                      "capability",
                      "channel",
                      "adapter"
                    ]
                  },
                  "metric": {
                    "enum": [
                      "child_spawns",
                      "concurrency",
                      "destructive_actions",
                      "dollar_micros",
                      "external_operations",
                      "output_bytes",
                      "processes",
                      "requests",
                      "tokens",
                      "tool_calls"
                    ]
                  },
                  "maximum": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "subject_ref": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 69,
                        "maxLength": 69,
                        "pattern": "^hmac:[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 7,
            "required": [
              "actor_ref",
              "capability",
              "route_ref",
              "resource_ref",
              "reported_state",
              "verified_state",
              "proof_gaps"
            ],
            "properties": {
              "actor_ref": {
                "type": "string",
                "minLength": 69,
                "maxLength": 69,
                "pattern": "^hmac:[a-f0-9]{64}$"
              },
              "capability": {
                "enum": [
                  "filesystem",
                  "network",
                  "tool",
                  "credential",
                  "process",
                  "message",
                  "storage",
                  "unknown"
                ]
              },
              "route_ref": {
                "type": "string",
                "minLength": 69,
                "maxLength": 69,
                "pattern": "^hmac:[a-f0-9]{64}$"
              },
              "resource_ref": {
                "type": "string",
                "minLength": 69,
                "maxLength": 69,
                "pattern": "^hmac:[a-f0-9]{64}$"
              },
              "reported_state": {
                "enum": [
                  "observe_only",
                  "mediated",
                  "physically_enforced",
                  "unsupported",
                  "coverage_gap"
                ]
              },
              "verified_state": {
                "enum": [
                  "unsupported",
                  "observe_only",
                  "coverage_gap"
                ]
              },
              "proof_gaps": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "enum": [
                    "unmediated_paths_uncovered",
                    "prehistory_unknown",
                    "coordinator_unavailable",
                    "durable_history_incomplete",
                    "capture_unavailable",
                    "projection_truncated",
                    "capture_pending_or_unavailable",
                    "capture_overflow",
                    "policy_snapshot_stale",
                    "route_inventory_missing",
                    "no_current_runtime_attestation",
                    "source_unavailable"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "proof_gaps": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "enum": [
          "unmediated_paths_uncovered",
          "prehistory_unknown",
          "coordinator_unavailable",
          "durable_history_incomplete",
          "capture_unavailable",
          "projection_truncated",
          "capture_pending_or_unavailable",
          "capture_overflow",
          "policy_snapshot_stale",
          "route_inventory_missing",
          "no_current_runtime_attestation",
          "source_unavailable"
        ]
      }
    },
    "execution_authority": {
      "const": false
    }
  }
}
