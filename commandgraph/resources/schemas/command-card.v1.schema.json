{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latentops.dev/schemas/commandgraph/command-card.v1.schema.json",
  "title": "CommandGraph Command Card v1",
  "type": "object",
  "required": ["schema_version", "command", "summary", "aliases", "intents", "default_risk", "risk_tags", "examples", "templates"],
  "properties": {
    "schema_version": {"const": "commandgraph.command_card.v1"},
    "command": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "intents": {"type": "array", "items": {"type": "string"}},
    "default_risk": {"enum": ["unknown", "low", "medium", "high", "critical"]},
    "risk_tags": {"type": "array", "items": {"type": "string"}},
    "examples": {"type": "array", "items": {"type": "object", "required": ["command", "explanation"], "properties": {"command": {"type": "string"}, "explanation": {"type": "string"}}, "additionalProperties": false}},
    "templates": {"type": "array", "items": {"type": "object", "required": ["command", "description"], "properties": {"command": {"type": "string"}, "description": {"type": "string"}, "safe_defaults": {"type": "object", "additionalProperties": {"type": "string"}}}, "additionalProperties": false}},
    "effects": {"type": "array"},
    "flags": {"type": "object"},
    "subcommands": {"type": "object"},
    "requires_privileges": {"type": "array", "items": {"type": "string"}},
    "safer_alternatives": {"type": "array"},
    "platforms": {"type": "object", "properties": {"os": {"type": "array", "items": {"type": "string"}}, "distro_ids": {"type": "array", "items": {"type": "string"}}, "distro_like": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "source": {"type": "string"},
    "man_section": {"type": "string"}
  },
  "additionalProperties": false
}
