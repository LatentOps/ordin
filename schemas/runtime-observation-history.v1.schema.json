{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latentops.space/ordin/schemas/runtime-observation-history.v1.schema.json",
  "title": "Ordin runtime observation history v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ordin.runtime_observation_history.v1"
    },
    "observations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "ordin.runtime_observation.v1"
          },
          "observation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$"
          },
          "action_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "action_digest": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "contract_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 67,
            "pattern": "^rc:[a-f0-9]{64}$"
          },
          "backend": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$"
          },
          "trust": {
            "type": "string",
            "enum": [
              "caller_asserted",
              "backend_observed",
              "backend_enforced"
            ]
          },
          "enforcement_point": {
            "type": "string",
            "enum": [
              "filesystem",
              "network",
              "process",
              "credential",
              "tool",
              "sandbox",
              "unknown"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "allowed",
              "denied",
              "failed",
              "completed",
              "unknown"
            ]
          },
          "operation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "effects": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-z][a-z0-9_.-]*$"
            }
          },
          "resources": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z][a-z0-9_.-]*$"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "required": [
                "type",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "reason_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "event_digest": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_schema_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "method": {
                "type": "string",
                "enum": [
                  "GET",
                  "HEAD",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE",
                  "OPTIONS",
                  "CONNECT",
                  "TRACE"
                ]
              },
              "host": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*$"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "binary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "process_id": {
                "type": "integer",
                "minimum": 0
              },
              "request_id_digest": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "graphql",
                  "mcp",
                  "json-rpc"
                ]
              },
              "request_commitment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              "request_commitment_algorithm": {
                "const": "ordin.authority-json.sha256.v1"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "session_digest": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "sandbox_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$"
          },
          "policy_digest": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "schema_version",
          "observation_id",
          "action_id",
          "action_digest",
          "contract_id",
          "backend",
          "trust",
          "enforcement_point",
          "outcome",
          "operation",
          "effects",
          "resources",
          "reason_code",
          "metadata",
          "session_digest",
          "sandbox_id",
          "policy_digest"
        ],
        "additionalProperties": false
      }
    },
    "contracts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "ordin.runtime_capability.v1"
          },
          "contract_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 67,
            "pattern": "^rc:[a-f0-9]{64}$"
          },
          "action_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128
          },
          "action_digest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "decision": {
            "type": "string",
            "enum": [
              "allow",
              "warn",
              "ask",
              "block"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical",
              "unknown"
            ]
          },
          "grant_state": {
            "type": "string",
            "enum": [
              "eligible",
              "requires_approval",
              "diagnostic"
            ]
          },
          "filesystem": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "properties": {
                "access": {
                  "type": "string",
                  "enum": [
                    "read",
                    "write",
                    "delete",
                    "metadata",
                    "execute",
                    "unknown"
                  ]
                },
                "path": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 4096
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "exact",
                    "prefix",
                    "unknown"
                  ]
                }
              },
              "required": [
                "access",
                "path",
                "scope"
              ],
              "additionalProperties": false
            }
          },
          "network": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "properties": {
                "host": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*$"
                },
                "port": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 65535
                },
                "protocol": {
                  "type": "string",
                  "enum": [
                    "rest",
                    "mcp",
                    "json-rpc",
                    "graphql",
                    "websocket",
                    "tcp",
                    "unknown"
                  ]
                },
                "access": {
                  "type": "string",
                  "enum": [
                    "read",
                    "write",
                    "unknown"
                  ]
                },
                "methods": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "string",
                    "enum": [
                      "GET",
                      "HEAD",
                      "POST",
                      "PUT",
                      "PATCH",
                      "DELETE",
                      "OPTIONS",
                      "CONNECT",
                      "TRACE"
                    ]
                  }
                },
                "paths": {
                  "type": "array",
                  "maxItems": 128,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "tool_identity": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "host",
                "port",
                "protocol",
                "access",
                "methods",
                "paths",
                "tool_identity"
              ],
              "additionalProperties": false
            }
          },
          "tools": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "properties": {
                "runtime": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "server": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 256
                },
                "tool": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "operation": {
                  "const": "call",
                  "type": "string"
                }
              },
              "required": [
                "runtime",
                "server",
                "tool",
                "operation"
              ],
              "additionalProperties": false
            }
          },
          "process": {
            "type": "object",
            "properties": {
              "execution": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "executables": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "spawn_children": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "execution",
              "executables",
              "spawn_children"
            ],
            "additionalProperties": false
          },
          "privilege": {
            "type": "object",
            "properties": {
              "escalation": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "required_euid": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "required": [
              "escalation",
              "required_euid"
            ],
            "additionalProperties": false
          },
          "credentials": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "properties": {
                "binding": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$"
                },
                "host": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*$"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "binding",
                "host",
                "port"
              ],
              "additionalProperties": false
            }
          },
          "unknowns": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string",
                  "enum": [
                    "filesystem",
                    "network",
                    "process",
                    "privilege",
                    "credential",
                    "tool",
                    "semantics"
                  ]
                },
                "reason_code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "required": [
                "domain",
                "reason_code",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "operation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "adapter": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 128
              },
              "effects": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[a-z][a-z0-9_.-]*$"
                }
              },
              "provenance_digest": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "kind",
              "operation",
              "adapter",
              "effects",
              "provenance_digest"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "schema_version",
          "contract_id",
          "action_id",
          "action_digest",
          "decision",
          "risk",
          "grant_state",
          "filesystem",
          "network",
          "tools",
          "process",
          "privilege",
          "credentials",
          "unknowns",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "observations",
    "contracts"
  ],
  "additionalProperties": false
}
