{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-credential-audit.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_digest",
    "binding_digest",
    "admission_digest",
    "action_digest",
    "status",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_credential_audit.v1"
    },
    "route_digest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "binding_digest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "admission_digest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "action_digest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "status": {
      "enum": [
        "host_completed",
        "unknown"
      ]
    },
    "execution_authority": {
      "const": false
    }
  }
}
