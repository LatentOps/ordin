{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-authority-audit.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "reference_digest",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_authority_audit.v1"
    },
    "kind": {
      "enum": [
        "root_published",
        "child_issued",
        "action_reviewed",
        "dispatch_uncertain",
        "dispatch_completed",
        "grant_revoked"
      ]
    },
    "reference_digest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "action_digest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "authority_digest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "parent_digest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "issuer_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "affected": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "disposition": {
      "enum": [
        "execute",
        "escalate",
        "deny"
      ]
    },
    "execution_authority": {
      "const": false
    }
  }
}
