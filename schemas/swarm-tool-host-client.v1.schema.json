{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-tool-host-client.v1.schema.json",
  "title": "swarm-tool-host-client",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "host",
    "port",
    "server_hostname",
    "profile_digest",
    "actor_id"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_tool_host_client.v1"
    },
    "host": {
      "const": "127.0.0.1"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "server_hostname": {
      "const": "localhost"
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    }
  }
}
