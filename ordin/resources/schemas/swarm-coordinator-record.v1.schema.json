{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-coordinator-record.v1.schema.json",
  "title": "swarm_coordinator_record",
  "description": "Bounded data-only optional coordinator metadata. JSON never authenticates a producer or restores live authority.",
  "$comment": "Transport canonical JSON is bounded to 65536 UTF-8 bytes, depth 32. Durable projections are bounded to 8MiB and never restore original grants/receipts. Runtime checks enforce exact channel, lease, epoch and scope bindings.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 13,
  "required": [
    "schema_version",
    "kind",
    "reference_digest",
    "scope_digest",
    "subject_digest",
    "policy_epoch",
    "owner_fence",
    "expires_at",
    "status",
    "action_digest",
    "requires_online_authority",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_coordinator_record.v1"
    },
    "kind": {
      "enum": [
        "lease",
        "grant",
        "evaluation",
        "reservation",
        "dispatch",
        "reconciliation"
      ]
    },
    "reference_digest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "subject_digest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "owner_fence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "action_digest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requires_online_authority": {
      "const": true
    },
    "execution_authority": {
      "const": false
    },
    "reference": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
