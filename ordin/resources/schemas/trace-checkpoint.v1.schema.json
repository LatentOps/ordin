{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/trace-checkpoint.v1.schema.json",
  "title": "trace_checkpoint",
  "description": "Privacy-default diagnostic data; never identity, permission or runtime authority. External anchor trust is independent of local history ownership.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 5,
  "required": [
    "schema_version",
    "event_count",
    "capture_digest",
    "owner_rewrite_possible",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.trace_checkpoint.v1"
    },
    "event_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "capture_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "owner_rewrite_possible": {
      "const": true
    },
    "execution_authority": {
      "const": false
    }
  }
}
