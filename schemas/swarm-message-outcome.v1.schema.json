{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-message-outcome.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "reason_code",
    "envelope_digest",
    "receiver_execution",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_message_outcome.v1"
    },
    "status": {
      "enum": [
        "delivered",
        "unknown"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
    },
    "envelope_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "maxLength": 64
    },
    "receiver_execution": {
      "const": "unknown"
    },
    "execution_authority": {
      "const": false
    }
  }
}
