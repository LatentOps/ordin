{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latentops.dev/schemas/ordin/command-pack.v1.schema.json",
  "title": "Ordin Command Pack v1",
  "type": "object",
  "required": ["schema_version", "name", "version", "description", "enabled_by_default", "commands", "risk_rules", "effect_catalogs", "analyzers"],
  "properties": {
    "schema_version": {"const": "ordin.command_pack.v1"},
    "name": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "version": {"type": "string", "minLength": 1, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 1},
    "enabled_by_default": {"type": "boolean"},
    "commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risk_rules": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "effect_catalogs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "analyzers": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
