{
  "$id": "https://latentops.space/ordin/schemas/assurance-profile-compilation.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "maxProperties": 10,
  "properties": {
    "compiled_policy_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "limitations": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$",
        "type": "string"
      },
      "maxItems": 32,
      "type": "array"
    },
    "profile_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "repository": {
      "additionalProperties": false,
      "maxProperties": 2,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "maxProperties": 4,
        "properties": {
          "invariant_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
            "type": "string"
          },
          "reason_code": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
            "type": "string"
          },
          "rule_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "compiled",
              "wrapper_required",
              "unsupported"
            ],
            "type": "string"
          }
        },
        "required": [
          "invariant_id",
          "status",
          "rule_id",
          "reason_code"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    },
    "schema_version": {
      "const": "ordin.assurance_profile_compilation.v1",
      "type": "string"
    },
    "selection_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_references": {
      "items": {
        "additionalProperties": false,
        "maxProperties": 5,
        "properties": {
          "content_digest": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "line": {
            "maximum": 10000000,
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
            "type": "string"
          },
          "revision": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
            "type": "string"
          },
          "symbol": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "line",
          "revision",
          "content_digest",
          "symbol"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    },
    "version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "repository",
    "profile_id",
    "version",
    "profile_digest",
    "selection_digest",
    "compiled_policy_digest",
    "rules",
    "source_references",
    "limitations"
  ],
  "title": "Ordin assurance profile compilation v1",
  "type": "object"
}
