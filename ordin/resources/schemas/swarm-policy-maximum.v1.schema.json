{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-policy-maximum.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "swarm_id",
    "permissions",
    "role_bindings",
    "agent_ids",
    "required_checks",
    "required_capabilities",
    "budget_limits",
    "delegation_maximum_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_policy_maximum.v1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
    },
    "swarm_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "action_kinds": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "database",
                  "file",
                  "mcp",
                  "network",
                  "shell",
                  "tool"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "effects": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "code.execute",
                  "code.remote_execute",
                  "confirmation.bypass",
                  "container.create",
                  "container.delete",
                  "container.prune",
                  "container.read",
                  "database.delete",
                  "database.read",
                  "database.write",
                  "filesystem.delete",
                  "filesystem.metadata_read",
                  "filesystem.ownership_change",
                  "filesystem.permission_change",
                  "filesystem.read",
                  "filesystem.recursive_delete",
                  "filesystem.recursive_ownership_change",
                  "filesystem.recursive_permission_change",
                  "filesystem.write",
                  "git.history_rewrite",
                  "git.local_write",
                  "git.read",
                  "git.remote_write",
                  "identity.permission_change",
                  "infrastructure.delete",
                  "infrastructure.read",
                  "infrastructure.write",
                  "network.connect",
                  "network.download",
                  "network.upload",
                  "package.install",
                  "package.read",
                  "package.remove",
                  "privilege.escalate",
                  "process.signal",
                  "remote.execute",
                  "secret.read",
                  "secret.write",
                  "service.control",
                  "service.read",
                  "system.configuration_write",
                  "system.device_write",
                  "system.power_change"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "tools": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "scope",
                  "name"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "tool",
                      "mcp"
                    ]
                  },
                  "scope": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "anyOf": [
                      {
                        "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^*\\x00-\\x1f\\x7f]+(?![\\s\\S])"
                      },
                      {
                        "pattern": "^[^*?\\[\\]\\x00-\\x1f\\x7f]+(?![\\s\\S])"
                      }
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "anyOf": [
                      {
                        "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^*\\x00-\\x1f\\x7f]+(?![\\s\\S])"
                      },
                      {
                        "pattern": "^[^*?\\[\\]\\x00-\\x1f\\x7f]+(?![\\s\\S])"
                      }
                    ]
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "resources": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "value"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "anyOf": [
                      {
                        "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^*\\x00-\\x1f\\x7f]+(?![\\s\\S])"
                      },
                      {
                        "pattern": "^[^*?\\[\\]\\x00-\\x1f\\x7f]+(?![\\s\\S])"
                      }
                    ]
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "destinations": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "anyOf": [
                  {
                    "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^*\\x00-\\x1f\\x7f]+(?![\\s\\S])"
                  },
                  {
                    "pattern": "^[^*?\\[\\]\\x00-\\x1f\\x7f]+(?![\\s\\S])"
                  }
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "data_labels": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "public",
                  "secret",
                  "pii",
                  "private_code"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "message_classes": {
          "anyOf": [
            {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "data",
                  "task_handoff",
                  "tool_result"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "role_bindings": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "role_ids"
        ],
        "properties": {
          "agent_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
          },
          "role_ids": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
            }
          }
        }
      }
    },
    "agent_ids": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "required_checks": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
      }
    },
    "required_capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "broker.enforce",
          "budget.admission",
          "delegation.online",
          "filesystem.enforce",
          "identity",
          "process.enforce",
          "protected_facts",
          "source_flow",
          "temporal"
        ]
      }
    },
    "budget_limits": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "metric",
          "maximum",
          "subject",
          "unknown_ceiling",
          "unknown_effects"
        ],
        "properties": {
          "scope": {
            "enum": [
              "tenant",
              "swarm",
              "task",
              "agent"
            ]
          },
          "metric": {
            "enum": [
              "child_spawns",
              "concurrency",
              "destructive_actions",
              "dollar_micros",
              "external_operations",
              "output_bytes",
              "processes",
              "requests",
              "tokens",
              "tool_calls"
            ]
          },
          "maximum": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "subject": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "unknown_ceiling": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000000
              },
              {
                "type": "null"
              }
            ]
          },
          "unknown_effects": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
            }
          }
        }
      }
    },
    "delegation_maximum_digest": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
