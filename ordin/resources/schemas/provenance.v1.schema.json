{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latentops.dev/schemas/ordin/provenance.v1.schema.json",
  "title": "Ordin Decision Provenance v1",
  "type": "object",
  "required": [
    "schema_version",
    "records",
    "final_decision",
    "final_risk"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.provenance.v1"
    },
    "records": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": [
          "source",
          "kind",
          "code",
          "summary",
          "decision",
          "risk",
          "effect",
          "resource",
          "rule_id",
          "action_id",
          "category",
          "matched_indices",
          "metadata"
        ],
        "properties": {
          "source": {
            "enum": [
              "adapter",
              "semantic",
              "risk_rule",
              "context",
              "intent",
              "observation",
              "temporal_policy",
              "action_policy",
              "decision"
            ]
          },
          "kind": {
            "enum": [
              "finding",
              "effect",
              "resource",
              "rule",
              "observation",
              "merge"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "summary": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32768
          },
          "decision": {
            "enum": [
              "allow",
              "warn",
              "ask",
              "block",
              null
            ]
          },
          "risk": {
            "enum": [
              "unknown",
              "low",
              "medium",
              "high",
              "critical",
              null
            ]
          },
          "effect": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32768
          },
          "resource": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_.-]*$"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32768
              }
            },
            "additionalProperties": false
          },
          "rule_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32768
          },
          "action_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32768
          },
          "category": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32768
          },
          "matched_indices": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "metadata": {
            "type": "object",
            "maxProperties": 64,
            "additionalProperties": {
              "type": [
                "string",
                "integer",
                "boolean",
                "null"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "final_decision": {
      "enum": [
        "allow",
        "warn",
        "ask",
        "block"
      ]
    },
    "final_risk": {
      "enum": [
        "unknown",
        "low",
        "medium",
        "high",
        "critical"
      ]
    }
  },
  "additionalProperties": false
}
