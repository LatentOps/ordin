{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-audit-verification.v1.schema.json",
  "title": "swarm_audit_verification",
  "description": "Privacy-default diagnostic data; never identity, permission or runtime authority. External anchor trust is independent of local history ownership.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 9,
  "required": [
    "schema_version",
    "valid",
    "first_sequence",
    "tail_sequence",
    "tail_hash",
    "checkpoint_status",
    "proof_gaps",
    "owner_rewrite_possible",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_audit_verification.v1"
    },
    "valid": {
      "type": "boolean"
    },
    "first_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tail_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tail_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "checkpoint_status": {
      "enum": [
        "not_supplied",
        "outside_retention_unknown",
        "matches_supplied_anchor",
        "invalid"
      ]
    },
    "proof_gaps": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "enum": [
          "audit.owner_can_rewrite_unanchored_history",
          "audit.retained_prefix_unavailable",
          "audit.checkpoint_outside_retention",
          "audit.invalid_or_corrupt_export",
          "audit.capture_incomplete"
        ]
      }
    },
    "owner_rewrite_possible": {
      "const": true
    },
    "execution_authority": {
      "const": false
    }
  }
}
