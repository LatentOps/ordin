{
  "schema_version": "ordin.command_card.v1",
  "command": "rm",
  "summary": "Remove files or directories.",
  "aliases": ["delete", "remove"],
  "intents": ["delete a file", "remove a directory", "clean generated files"],
  "default_risk": "high",
  "risk_tags": ["destructive_delete", "filesystem_write"],
  "effects": [{"effect": "filesystem.delete", "resource": "filesystem.target"}],
  "flags": {
    "-r": {
      "aliases": ["-R", "--recursive"],
      "effects": [{"effect": "filesystem.recursive_delete", "resource": "filesystem.target"}]
    },
    "-f": {
      "aliases": ["--force"],
      "effects": [{"effect": "confirmation.bypass", "resource": "filesystem.target"}]
    }
  },
  "safer_alternatives": [
    {"command": "find", "reason": "Preview the target set before deleting recursively."}
  ],
  "examples": [
    {"command": "rm old.log", "explanation": "Remove a single file."},
    {"command": "rm -rf build/", "explanation": "Recursively remove a build directory. Inspect the path first."}
  ],
  "templates": [
    {"command": "rm {path}", "description": "Remove one file. Inspect the path first."},
    {"command": "rm -rf {path}", "description": "Recursively remove a path. High risk; inspect first."}
  ]
}
