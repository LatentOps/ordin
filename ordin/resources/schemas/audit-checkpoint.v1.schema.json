{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/audit-checkpoint.v1.schema.json",
  "title": "audit_checkpoint",
  "description": "Privacy-default diagnostic data; never identity, permission or runtime authority. External anchor trust is independent of local history ownership.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 5,
  "required": [
    "schema_version",
    "event_count",
    "tail_hash",
    "owner_rewrite_possible",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.audit_checkpoint.v1"
    },
    "event_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tail_hash": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "owner_rewrite_possible": {
      "const": true
    },
    "execution_authority": {
      "const": false
    }
  }
}
