{
  "schema_version": "ordin.command_card.v1",
  "command": "chown",
  "summary": "Change file owner and group.",
  "aliases": ["change owner", "file ownership", "owner group"],
  "intents": ["change file owner", "fix ownership", "change directory owner"],
  "default_risk": "high",
  "risk_tags": ["ownership_change", "recursive_ownership_change"],
  "effects": [{"effect": "filesystem.ownership_change", "resource": "filesystem.target"}],
  "flags": {
    "-R": {
      "aliases": ["--recursive"],
      "effects": [{"effect": "filesystem.recursive_ownership_change", "resource": "filesystem.target"}]
    }
  },
  "requires_privileges": ["ownership_change_authority"],
  "examples": [{"command": "chown user:group file.txt", "explanation": "Change owner and group for one file."}],
  "templates": [{"command": "chown <user>:<group> {path}", "description": "Change ownership for a path."}]
}
