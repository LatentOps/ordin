{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-coordinator-status.v1.schema.json",
  "title": "swarm_coordinator_status",
  "description": "Bounded data-only optional coordinator metadata. JSON never authenticates a producer or restores live authority.",
  "$comment": "Transport canonical JSON is bounded to 65536 UTF-8 bytes, depth 32. Durable projections are bounded to 8MiB and never restore original grants/receipts. Runtime checks enforce exact channel, lease, epoch and scope bindings.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 20,
  "required": [
    "schema_version",
    "scope_digest",
    "database_digest",
    "backend",
    "mode",
    "online",
    "policy_epoch",
    "policy_digest",
    "owner_fence",
    "journal_sequence",
    "checkpoint_sequence",
    "journal_incomplete",
    "projection_lag",
    "prehistory",
    "workload_count",
    "grant_count",
    "reservations",
    "unmediated_execution",
    "physical_enforcement",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_coordinator_status.v1"
    },
    "scope_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "database_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "backend": {
      "enum": [
        "sqlite",
        "postgresql"
      ]
    },
    "mode": {
      "enum": [
        "multi_host_postgresql",
        "single_host_dev"
      ]
    },
    "online": {
      "type": "boolean"
    },
    "policy_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "policy_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "owner_fence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "journal_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "checkpoint_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "journal_incomplete": {
      "type": "boolean"
    },
    "projection_lag": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "prehistory": {
      "const": "unknown"
    },
    "workload_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "grant_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reservations": {
      "type": "object",
      "maxProperties": 9,
      "properties": {
        "preparing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "forwarding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncertain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "committed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "canceled": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expired": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "denied": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "unmediated_execution": {
      "const": "uncovered"
    },
    "physical_enforcement": {
      "const": false
    },
    "execution_authority": {
      "const": false
    }
  }
}
