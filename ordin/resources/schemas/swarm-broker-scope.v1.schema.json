{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-broker-scope.v1.schema.json",
  "title": "swarm_broker_scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_digest",
    "context_digest",
    "plan_digest",
    "caller_digest",
    "authorization_digest",
    "expires_at",
    "policy_digest",
    "budget_reservation_digest",
    "delegation_admission_digest",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_broker_scope.v1"
    },
    "action_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "caller_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorization_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "budget_reservation_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "delegation_admission_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "execution_authority": {
      "const": false
    }
  }
}
