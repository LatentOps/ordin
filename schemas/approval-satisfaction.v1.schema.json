{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.latentops.dev/schemas/approval-satisfaction.v1.schema.json",
  "title": "Approval Satisfaction (data only)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ordin.approval_satisfaction.v1"
    },
    "satisfaction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]*$"
    },
    "action_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operator_maximum_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "budget_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "delegation_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "capabilities_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "revocation_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "owner_fence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "context_digest",
        "policy_digest",
        "scope_digest",
        "operator_maximum_digest",
        "budget_digest",
        "delegation_digest",
        "capabilities_digest",
        "policy_epoch",
        "revocation_epoch",
        "owner_fence"
      ],
      "maxProperties": 10
    },
    "source_binding": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "host_approval_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expires_at": {
      "type": "number",
      "minimum": 0
    },
    "fulfilled_obligation": {
      "const": "operator_review"
    },
    "execution_authority": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "satisfaction_id",
    "action_digest",
    "review_digest",
    "configuration_digest",
    "scope",
    "source_binding",
    "host_approval_digest",
    "expires_at",
    "fulfilled_obligation",
    "execution_authority"
  ],
  "maxProperties": 11
}
