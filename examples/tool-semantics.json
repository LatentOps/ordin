{
  "schema_version": "ordin.tool_semantics.v1",
  "registry_id": "example-local-tools",
  "version": "1",
  "rules": [
    {
      "id": "filesystem-read-file",
      "kind": "mcp",
      "server": "filesystem-local",
      "tool": "read_file",
      "effects": ["filesystem.read"],
      "resources": [
        {"argument": "path", "type": "path"}
      ]
    },
    {
      "id": "agent-upload",
      "kind": "tool",
      "runtime": "example-agent",
      "tool": "upload_file",
      "effects": ["network.upload"],
      "resources": [
        {"argument": "destination", "type": "url"}
      ]
    }
  ]
}
