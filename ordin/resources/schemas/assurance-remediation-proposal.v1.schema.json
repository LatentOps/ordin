{
  "$id": "https://latentops.space/ordin/schemas/assurance-remediation-proposal.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "maxProperties": 15,
  "properties": {
    "applied": {
      "const": false,
      "type": "boolean"
    },
    "authority_delta": {
      "enum": [
        "unchanged",
        "narrowed",
        "widened",
        "unsupported",
        "unknown"
      ],
      "type": "string"
    },
    "baseline_policy_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "candidate_policy_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "expected_authority_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "finding_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "limitations": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$",
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "proposal_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "proposed_source_patch_digest": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "protected_host_configuration_changed": {
      "type": "boolean"
    },
    "repository_after": {
      "additionalProperties": false,
      "maxProperties": 2,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "repository_before": {
      "additionalProperties": false,
      "maxProperties": 2,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "review_required": {
      "const": true,
      "type": "boolean"
    },
    "schema_version": {
      "const": "ordin.assurance_remediation_proposal.v1",
      "type": "string"
    },
    "validation_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "proposal_id",
    "validation_digest",
    "finding_digest",
    "repository_before",
    "repository_after",
    "baseline_policy_digest",
    "candidate_policy_digest",
    "expected_authority_digest",
    "authority_delta",
    "protected_host_configuration_changed",
    "proposed_source_patch_digest",
    "review_required",
    "applied",
    "limitations"
  ],
  "title": "Ordin assurance remediation proposal v1",
  "type": "object"
}
