{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latentops.dev/schemas/ordin/action-history.v1.schema.json",
  "title": "Ordin Action History v1",
  "type": "object",
  "required": ["schema_version", "actions"],
  "properties": {
    "schema_version": {"const": "ordin.action_history.v1"},
    "actions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["schema_version", "action_id", "kind", "operation", "parameters", "intent", "context"],
        "properties": {
          "schema_version": {"const": "ordin.action_envelope.v1"},
          "action_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
          "kind": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_.-]*$"},
          "operation": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]*$"},
          "parameters": {"type": "object", "maxProperties": 128, "additionalProperties": true},
          "intent": {"type": ["string", "null"]},
          "context": {
            "type": ["object", "null"],
            "properties": {
              "cwd": {"type": ["string", "null"]},
              "shell": {"type": ["string", "null"]},
              "euid": {"type": ["integer", "null"], "minimum": 0},
              "interactive": {"type": ["boolean", "null"]},
              "repo_root": {"type": ["string", "null"]},
              "agent": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
