{
  "$id": "https://latentops.space/ordin/schemas/assurance-workflow-claim.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "maxProperties": 10,
  "properties": {
    "identifier_digest": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "const": "imported_claim",
      "type": "string"
    },
    "payload_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "payload_parts": {
      "items": {
        "maxLength": 4000,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$",
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "record_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "reported_verdict": {
      "enum": [
        "reportable",
        "suppressed",
        "not_applicable",
        "deferred",
        "verified",
        "no_change",
        "blocked",
        "failed",
        "fixed",
        "still_vulnerable",
        "inconclusive",
        "merge",
        "revise",
        "no_op",
        "block",
        "hold_for_evidence",
        "changes_reported",
        "unknown"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": "ordin.assurance_workflow_claim.v1",
      "type": "string"
    },
    "status": {
      "const": "imported",
      "type": "string"
    },
    "verification_method": {
      "const": "none",
      "type": "string"
    },
    "workflow": {
      "enum": [
        "validate",
        "patch",
        "verify_fix",
        "patch_risk"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "workflow",
    "identifier_digest",
    "reported_verdict",
    "payload_parts",
    "payload_digest",
    "origin",
    "status",
    "verification_method"
  ],
  "title": "Ordin assurance workflow claim v1",
  "type": "object"
}
