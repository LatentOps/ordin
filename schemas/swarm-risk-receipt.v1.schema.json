{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-risk-receipt.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "status",
    "signal",
    "context_digest",
    "action_digest",
    "input_digest",
    "provider_binding",
    "expires_at",
    "elapsed_ms",
    "reserved_cost_micros",
    "budget",
    "privacy_mode",
    "evidence_class",
    "execution_authority",
    "verified_effects"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_risk_receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "scored",
        "failed",
        "timeout",
        "stale",
        "budget_exhausted"
      ]
    },
    "signal": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "signal_class",
            "evidence_pointers",
            "confidence",
            "uncertainty",
            "reported_cost_micros",
            "budget",
            "evidence_class",
            "execution_authority",
            "verified_effects"
          ],
          "properties": {
            "schema_version": {
              "const": "ordin.swarm_risk_signal.v1"
            },
            "signal_class": {
              "enum": [
                "none",
                "unknown",
                "prompt_injection",
                "policy_persuasion",
                "task_redirection",
                "collusive_coordination",
                "evasive_retry",
                "coordinated_plan_change"
              ]
            },
            "evidence_pointers": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "maxItems": 16,
              "uniqueItems": true
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "uncertainty": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reported_cost_micros": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "budget": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "time_ms",
                "cost_micros"
              ],
              "properties": {
                "time_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "cost_micros": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                }
              }
            },
            "evidence_class": {
              "const": "behavioral_inference"
            },
            "execution_authority": {
              "const": false
            },
            "verified_effects": {
              "const": false
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "context_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "action_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_binding": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expires_at": {
      "type": "number",
      "minimum": 0
    },
    "elapsed_ms": {
      "type": "number",
      "minimum": 0
    },
    "reserved_cost_micros": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_ms",
        "cost_micros"
      ],
      "properties": {
        "time_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cost_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "privacy_mode": {
      "enum": [
        "features_only",
        "redacted_excerpt_opt_in"
      ]
    },
    "evidence_class": {
      "const": "behavioral_inference"
    },
    "execution_authority": {
      "const": false
    },
    "verified_effects": {
      "const": false
    }
  }
}
