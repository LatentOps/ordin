{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latentops.space/ordin/schemas/runtime-observation.v1.schema.json",
  "title": "Ordin runtime observation v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ordin.runtime_observation.v1"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$"
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "action_digest": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "contract_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 67,
      "pattern": "^rc:[a-f0-9]{64}$"
    },
    "backend": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$"
    },
    "trust": {
      "type": "string",
      "enum": [
        "caller_asserted",
        "backend_observed",
        "backend_enforced"
      ]
    },
    "enforcement_point": {
      "type": "string",
      "enum": [
        "filesystem",
        "network",
        "process",
        "credential",
        "tool",
        "sandbox",
        "unknown"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "allowed",
        "denied",
        "failed",
        "completed",
        "unknown"
      ]
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "effects": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[a-z][a-z0-9_.-]*$"
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "type",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "event_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_schema_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS",
            "CONNECT",
            "TRACE"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "binary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "process_id": {
          "type": "integer",
          "minimum": 0
        },
        "request_id_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "session_digest": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "sandbox_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$"
    },
    "policy_digest": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "observation_id",
    "action_id",
    "action_digest",
    "contract_id",
    "backend",
    "trust",
    "enforcement_point",
    "outcome",
    "operation",
    "effects",
    "resources",
    "reason_code",
    "metadata",
    "session_digest",
    "sandbox_id",
    "policy_digest"
  ],
  "additionalProperties": false
}
