+pub(crate) fn emit_request_authority(
+    ctx: &L7EvalContext,
+    action: &str,
+    target: &str,
+    protocol: &str,
+    algorithm: &str,
+    commitment: &str,
+) {
+    let event = HttpActivityBuilder::new(openshell_ocsf::ctx::ctx())
+        .activity(ActivityId::Other).action(ActionId::Allowed).disposition(DispositionId::Allowed).severity(SeverityId::Informational)
+        .http_request(HttpRequest::new(action, OcsfUrl::new("http", &ctx.host, target, ctx.port)))
+        .dst_endpoint(Endpoint::from_domain(&ctx.host, ctx.port)).firewall_rule(&ctx.policy_name, "l7-request-authority")
+        .unmapped("request_authority", serde_json::json!({"protocol": protocol, "algorithm": algorithm, "commitment": commitment, "enforcement": "enforce"}))
+        .unmapped("workload_binary", ctx.binary_path.clone())
+        .message("Committed request delivered upstream").build();
+    ocsf_emit!(event);
+}
