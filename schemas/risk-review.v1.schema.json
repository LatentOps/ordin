{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latentops.dev/schemas/commandgraph/risk-review.v1.schema.json",
  "title": "CommandGraph Risk Review v1",
  "type": "object",
  "required": ["schema_version", "decision", "risk", "reasons", "safer_next_step", "matched_rules", "risk_categories"],
  "properties": {
    "schema_version": {"const": "commandgraph.risk_review.v1"},
    "decision": {"enum": ["allow", "warn", "ask", "block"]},
    "risk": {"enum": ["unknown", "low", "medium", "high", "critical"]},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "safer_next_step": {"type": ["string", "null"]},
    "matched_rules": {"type": "array", "items": {"type": "string"}},
    "risk_categories": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
