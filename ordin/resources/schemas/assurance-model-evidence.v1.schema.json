{
  "$id": "https://latentops.space/ordin/schemas/assurance-model-evidence.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "maxProperties": 14,
  "properties": {
    "answers": {
      "items": {
        "additionalProperties": false,
        "maxProperties": 2,
        "properties": {
          "p_yes": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "question_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "question_id",
          "p_yes"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "type": "array"
    },
    "calibration_ref": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "consent_ref": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_class": {
      "enum": [
        "none",
        "timeout",
        "unavailable",
        "malformed",
        "refused",
        "version_mismatch",
        "transport",
        "question_mismatch",
        "canceled",
        "privacy",
        "budget"
      ],
      "type": "string"
    },
    "evidence_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "input_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "latency_ms": {
      "maximum": 86400000,
      "minimum": 0,
      "type": "number"
    },
    "model_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "provider": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "question_set_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "question_set_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "redaction_policy_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "schema_version": {
      "const": "ordin.assurance_model_evidence.v1",
      "type": "string"
    },
    "supportedness": {
      "enum": [
        "supported",
        "unsupported",
        "inconclusive"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "evidence_id",
    "provider",
    "model_version",
    "question_set_id",
    "question_set_digest",
    "redaction_policy_id",
    "input_digest",
    "answers",
    "supportedness",
    "latency_ms",
    "error_class",
    "calibration_ref",
    "consent_ref"
  ],
  "title": "Ordin assurance model evidence v1",
  "type": "object"
}
