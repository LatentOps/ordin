{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-message.v1.schema.json",
  "title": "Swarm message metadata; JSON does not authenticate delivery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "sender",
    "destination",
    "task_id",
    "sequence",
    "issued_at",
    "expires_at",
    "content_class",
    "content_digest",
    "byte_length",
    "parent_event_ids",
    "source_lineage",
    "labels",
    "instruction_authority",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_message.v1"
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
    },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "swarm_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "runtime_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "policy_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "parent_agent_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "delegation_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "parent_generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "oneOf": [
        {
          "properties": {
            "parent_agent_id": {
              "type": "null"
            },
            "parent_generation": {
              "type": "null"
            },
            "delegation_id": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "parent_agent_id": {
              "type": "string"
            },
            "parent_generation": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ],
      "required": [
        "tenant_id",
        "swarm_id",
        "agent_id",
        "runtime_id",
        "session_id",
        "generation",
        "policy_epoch",
        "parent_agent_id",
        "task_id",
        "delegation_id",
        "parent_generation"
      ]
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "swarm_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "runtime_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "policy_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "parent_agent_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "delegation_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "parent_generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "oneOf": [
        {
          "properties": {
            "parent_agent_id": {
              "type": "null"
            },
            "parent_generation": {
              "type": "null"
            },
            "delegation_id": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "parent_agent_id": {
              "type": "string"
            },
            "parent_generation": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ],
      "required": [
        "tenant_id",
        "swarm_id",
        "agent_id",
        "runtime_id",
        "session_id",
        "generation",
        "policy_epoch",
        "parent_agent_id",
        "task_id",
        "delegation_id",
        "parent_generation"
      ]
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "issued_at": {
      "type": "number",
      "minimum": 0,
      "maximum": 1e+18
    },
    "expires_at": {
      "type": "number",
      "minimum": 0,
      "maximum": 1e+18
    },
    "content_class": {
      "enum": [
        "data",
        "task_handoff",
        "tool_result"
      ]
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "maxLength": 64
    },
    "byte_length": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "parent_event_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenant_id",
          "swarm_id",
          "event_id"
        ],
        "properties": {
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
          },
          "swarm_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
          },
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
          }
        }
      }
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
        "maxLength": 64
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "public",
          "secret",
          "pii",
          "private_code",
          "unclassified"
        ]
      }
    },
    "instruction_authority": {
      "const": "data"
    },
    "execution_authority": {
      "const": false
    }
  }
}
