{
  "$id": "https://latentops.space/ordin/schemas/assurance-counterexample.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "maxProperties": 18,
  "properties": {
    "baseline_result": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "candidate_result": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "claimed_property": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "environment": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "type": "string"
    },
    "generator_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "initial_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "initial_input": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "type": "string"
    },
    "minimized_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "minimized_input": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "type": "string"
    },
    "mutation": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "proof_gaps": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$",
        "type": "string"
      },
      "maxItems": 32,
      "type": "array"
    },
    "provenance_kind": {
      "enum": [
        "synthetic_fixture",
        "sanitized_replay"
      ],
      "type": "string"
    },
    "record_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "replay_outcome": {
      "enum": [
        "verified_failure",
        "not_reproduced",
        "inconclusive"
      ],
      "type": "string"
    },
    "revision": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "safe_fixture_only": {
      "const": true,
      "type": "boolean"
    },
    "schema_version": {
      "const": "ordin.assurance_counterexample.v1",
      "type": "string"
    },
    "seed": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "claimed_property",
    "seed",
    "generator_version",
    "mutation",
    "initial_input",
    "minimized_input",
    "initial_digest",
    "minimized_digest",
    "baseline_result",
    "candidate_result",
    "replay_outcome",
    "revision",
    "environment",
    "provenance_kind",
    "safe_fixture_only",
    "proof_gaps"
  ],
  "title": "Ordin assurance counterexample v1",
  "type": "object"
}
