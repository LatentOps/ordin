{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-artifact.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "address",
    "owner_digest",
    "version",
    "content_digest",
    "byte_length",
    "labels",
    "expires_at",
    "write_event",
    "source_lineage",
    "proof_gaps",
    "instruction_authority",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_artifact.v1"
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "swarm_id",
        "workspace_id",
        "namespace",
        "key",
        "kind"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "swarm_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "kind": {
          "enum": [
            "artifact",
            "workspace",
            "kv",
            "vector_entry"
          ]
        }
      }
    },
    "owner_digest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "content_digest": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "byte_length": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "public",
          "secret",
          "pii",
          "private_code",
          "unclassified"
        ]
      }
    },
    "expires_at": {
      "type": "number",
      "minimum": 0,
      "maximum": 1e+18
    },
    "write_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "swarm_id",
        "event_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "swarm_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        }
      }
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
      }
    },
    "proof_gaps": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
      }
    },
    "instruction_authority": {
      "const": "data"
    },
    "execution_authority": {
      "const": false
    }
  }
}
