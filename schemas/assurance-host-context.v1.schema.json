{
  "$id": "https://latentops.space/ordin/schemas/assurance-host-context.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "maxProperties": 9,
  "properties": {
    "approval_digests": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "assessment_digests": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "capability_authorities": {
      "items": {
        "additionalProperties": false,
        "maxProperties": 2,
        "properties": {
          "authority_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
            "type": "string"
          },
          "boundary_digest": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "authority_id",
          "boundary_digest"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "type": "array"
    },
    "credential_use_digests": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "maxItems": 128,
      "type": "array"
    },
    "history_digest": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_authorities": {
      "items": {
        "additionalProperties": false,
        "maxProperties": 2,
        "properties": {
          "authority_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
            "type": "string"
          },
          "boundary_digest": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "authority_id",
          "boundary_digest"
        ],
        "type": "object"
      },
      "maxItems": 128,
      "type": "array"
    },
    "schema_version": {
      "const": "ordin.assurance_host_context.v1",
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "maxProperties": 6,
      "properties": {
        "epoch": {
          "maximum": 1000000000,
          "minimum": 0,
          "type": "integer"
        },
        "principal": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
          "type": "string"
        },
        "repository": {
          "additionalProperties": false,
          "maxProperties": 2,
          "properties": {
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
              "type": "string"
            },
            "revision": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
              "type": "string"
            }
          },
          "required": [
            "id",
            "revision"
          ],
          "type": "object"
        },
        "runtime_policy_digest": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "selection_digest": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "session_digest": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "principal",
        "repository",
        "session_digest",
        "epoch",
        "runtime_policy_digest",
        "selection_digest"
      ],
      "type": "object"
    },
    "source_key": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scope",
    "source_key",
    "capability_authorities",
    "request_authorities",
    "approval_digests",
    "assessment_digests",
    "credential_use_digests",
    "history_digest"
  ],
  "title": "Ordin assurance host context v1",
  "type": "object"
}
