{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-operator-list.v1.schema.json",
  "title": "swarm_operator_list",
  "description": "Privacy-default diagnostic data; never identity, permission or runtime authority. External anchor trust is independent of local history ownership.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 3,
  "required": [
    "schema_version",
    "scopes",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_operator_list.v1"
    },
    "scopes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 3,
        "required": [
          "scope_ref",
          "agents",
          "proof_gaps"
        ],
        "properties": {
          "scope_ref": {
            "type": "string",
            "minLength": 69,
            "maxLength": 69,
            "pattern": "^hmac:[a-f0-9]{64}$"
          },
          "agents": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 8,
              "required": [
                "actor_ref",
                "session_ref",
                "parent_ref",
                "generation",
                "policy_epoch",
                "phase",
                "containment",
                "reported_mode"
              ],
              "properties": {
                "actor_ref": {
                  "type": "string",
                  "minLength": 69,
                  "maxLength": 69,
                  "pattern": "^hmac:[a-f0-9]{64}$"
                },
                "session_ref": {
                  "type": "string",
                  "minLength": 69,
                  "maxLength": 69,
                  "pattern": "^hmac:[a-f0-9]{64}$"
                },
                "parent_ref": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 69,
                      "maxLength": 69,
                      "pattern": "^hmac:[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "generation": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "policy_epoch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "phase": {
                  "enum": [
                    "active",
                    "retired",
                    "failed",
                    "exited",
                    "stale",
                    "unknown"
                  ]
                },
                "containment": {
                  "enum": [
                    "unknown",
                    "permission_fenced",
                    "not_fenced_in_this_snapshot"
                  ]
                },
                "reported_mode": {
                  "enum": [
                    "observe",
                    "intercept",
                    "enforce",
                    "uncovered"
                  ]
                }
              }
            }
          },
          "proof_gaps": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "enum": [
                "unmediated_paths_uncovered",
                "prehistory_unknown",
                "coordinator_unavailable",
                "durable_history_incomplete",
                "capture_unavailable",
                "projection_truncated",
                "capture_pending_or_unavailable",
                "capture_overflow",
                "policy_snapshot_stale",
                "route_inventory_missing",
                "no_current_runtime_attestation",
                "source_unavailable",
                "offline_report_not_live_verification"
              ]
            }
          }
        }
      }
    },
    "execution_authority": {
      "const": false
    }
  }
}
