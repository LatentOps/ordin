{
  "$id": "https://latentops.space/ordin/schemas/assurance-host-credential-use.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "maxProperties": 8,
  "properties": {
    "action_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "binding": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "host": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "type": "string"
    },
    "port": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
    },
    "profile_digest": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "receipt_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "schema_version": {
      "const": "ordin.assurance_host_credential_use.v1",
      "type": "string"
    },
    "source_key": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "source_key",
    "action_digest",
    "profile_digest",
    "binding",
    "host",
    "port"
  ],
  "title": "Ordin assurance host credential use v1",
  "type": "object"
}
