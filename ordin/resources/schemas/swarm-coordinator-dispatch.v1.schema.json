{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-coordinator-dispatch.v1.schema.json",
  "title": "swarm_coordinator_dispatch",
  "description": "Bounded data-only optional coordinator metadata. JSON never authenticates a producer or restores live authority.",
  "$comment": "Transport canonical JSON is bounded to 65536 UTF-8 bytes, depth 32. Durable projections are bounded to 8MiB and never restore original grants/receipts. Runtime checks enforce exact channel, lease, epoch and scope bindings.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 8,
  "required": [
    "schema_version",
    "status",
    "reservation_digest",
    "action_digest",
    "reason_code",
    "physical_enforcement",
    "runtime_evidence",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_coordinator_dispatch.v1"
    },
    "status": {
      "enum": [
        "host_completed",
        "unknown"
      ]
    },
    "reservation_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "action_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "physical_enforcement": {
      "const": false
    },
    "runtime_evidence": {
      "const": "separate_broker_boundary"
    },
    "execution_authority": {
      "const": false
    }
  }
}
