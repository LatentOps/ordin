{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://ordin.dev/schemas/swarm-attach-status.v1.schema.json",
  "required": [
    "schema_version",
    "session_digest",
    "state",
    "mode",
    "generation",
    "attachment_count",
    "reason_code",
    "pre_attach_history",
    "current_window",
    "pathways",
    "execution_authority",
    "physical_enforcement"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_attach_status.v1"
    },
    "session_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "attached",
        "detached"
      ]
    },
    "mode": {
      "enum": [
        "observe",
        "intercept",
        "enforce"
      ]
    },
    "pre_attach_history": {
      "const": "unknown"
    },
    "execution_authority": {
      "const": false
    },
    "pathways": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pathway",
          "state",
          "coverage",
          "plan"
        ],
        "properties": {
          "pathway": {
            "enum": [
              "hook",
              "mcp",
              "sdk",
              "gateway",
              "outbound_network",
              "credential",
              "executor"
            ]
          },
          "state": {
            "enum": [
              "covered",
              "uncovered",
              "unknown",
              "restart_required"
            ]
          },
          "coverage": {
            "enum": [
              "mediated",
              "observe_only",
              "coverage_gap"
            ]
          },
          "plan": {
            "enum": [
              "route_egress_or_restart_in_constrained_runtime",
              "revoke_or_rotate_existing_credentials",
              "stop_and_restart_with_constrained_executor",
              "verify_future_call_routing"
            ]
          }
        }
      }
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "attachment_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16384
    },
    "reason_code": {
      "enum": [
        "attached",
        "not_attached",
        "detached",
        "attach_failed",
        "event_continuity_gap",
        "disconnected_or_stale",
        "routing_restore_failed"
      ]
    },
    "current_window": {
      "enum": [
        "continuous_since_attach",
        "unknown"
      ]
    },
    "physical_enforcement": {
      "const": false
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[a-z_]+$"
      }
    },
    "report_source": {
      "const": "untrusted_file"
    },
    "verified_live": {
      "const": false
    }
  }
}
