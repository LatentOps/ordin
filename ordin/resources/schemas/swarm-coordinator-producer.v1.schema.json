{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.dev/schemas/swarm-coordinator-producer.v1.schema.json",
  "title": "swarm_coordinator_producer",
  "description": "Bounded data-only optional coordinator metadata. JSON never authenticates a producer or restores live authority.",
  "$comment": "Transport canonical JSON is bounded to 65536 UTF-8 bytes, depth 32. Durable projections are bounded to 8MiB and never restore original grants/receipts. Runtime checks enforce exact channel, lease, epoch and scope bindings.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 7,
  "required": [
    "schema_version",
    "registry_id",
    "identity",
    "source_id",
    "next_sequence",
    "prehistory",
    "execution_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "ordin.swarm_coordinator_producer.v1"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "swarm_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "runtime_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "policy_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "parent_agent_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "delegation_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}(?![\\s\\S])"
        },
        "parent_generation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "oneOf": [
        {
          "properties": {
            "parent_agent_id": {
              "type": "null"
            },
            "parent_generation": {
              "type": "null"
            },
            "delegation_id": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "parent_agent_id": {
              "type": "string"
            },
            "parent_generation": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ],
      "required": [
        "tenant_id",
        "swarm_id",
        "agent_id",
        "runtime_id",
        "session_id",
        "generation",
        "policy_epoch",
        "parent_agent_id",
        "task_id",
        "delegation_id",
        "parent_generation"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "next_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "prehistory": {
      "const": "unknown"
    },
    "execution_authority": {
      "const": false
    }
  }
}
