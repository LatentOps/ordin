{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latentops.dev/schemas/ordin/action-trace.v1.schema.json",
  "title": "Ordin Action Trace v1",
  "type": "object",
  "required": ["schema_version", "actions"],
  "properties": {
    "schema_version": {"const": "ordin.action_trace.v1"},
    "actions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["command"],
        "properties": {"command": {"type": "string", "minLength": 1}},
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
