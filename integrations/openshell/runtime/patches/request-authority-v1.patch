+pub(crate) fn integrity_protocol(protocol: L7Protocol) -> &'static str {
+    match protocol {
+        L7Protocol::Graphql => "graphql",
+        L7Protocol::Mcp => "mcp",
+        L7Protocol::JsonRpc => "json-rpc",
+        _ => "",
+    }
