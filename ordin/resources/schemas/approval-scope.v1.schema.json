{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordin.latentops.dev/schemas/approval-scope.v1.schema.json",
  "title": "Approval Scope (data only)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operator_maximum_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "budget_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "delegation_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilities_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "revocation_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "owner_fence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  },
  "required": [
    "context_digest",
    "policy_digest",
    "scope_digest",
    "operator_maximum_digest",
    "budget_digest",
    "delegation_digest",
    "capabilities_digest",
    "policy_epoch",
    "revocation_epoch",
    "owner_fence"
  ],
  "maxProperties": 10
}
