{
  "$id": "https://latentops.space/ordin/schemas/assurance-security-profile.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "maxProperties": 8,
  "properties": {
    "invariants": {
      "items": {
        "$id": "https://latentops.space/ordin/schemas/assurance-invariant.v1.schema.json",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "maxProperties": 9,
        "properties": {
          "authority_ref": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "invariant_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "require_approval",
              "forbid_effect",
              "resource_subset",
              "network_request_subset",
              "credential_binding",
              "delegated_authority_subset",
              "source_flow_guard",
              "temporal_action_guard",
              "protected_policy_mutation"
            ],
            "type": "string"
          },
          "mandatory": {
            "type": "boolean"
          },
          "on_violation": {
            "enum": [
              "escalate",
              "block"
            ],
            "type": "string"
          },
          "provenance": {
            "items": {
              "additionalProperties": false,
              "maxProperties": 7,
              "properties": {
                "action_digest": {
                  "anyOf": [
                    {
                      "maxLength": 64,
                      "minLength": 1,
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "contract_id": {
                  "anyOf": [
                    {
                      "maxLength": 128,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence_id": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
                  "type": "string"
                },
                "origin": {
                  "enum": [
                    "caller_asserted",
                    "static_evidence",
                    "imported_claim",
                    "model_hypothesis",
                    "deterministically_derived",
                    "policy_verified",
                    "runtime_backend_observed",
                    "host_authenticated_source"
                  ],
                  "type": "string"
                },
                "proof_gaps": {
                  "items": {
                    "maxLength": 4096,
                    "minLength": 1,
                    "pattern": "^[^\\x00-\\x1f\\x7f]+$",
                    "type": "string"
                  },
                  "maxItems": 32,
                  "type": "array"
                },
                "session_digest": {
                  "anyOf": [
                    {
                      "maxLength": 64,
                      "minLength": 1,
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "maxProperties": 5,
                      "properties": {
                        "content_digest": {
                          "maxLength": 64,
                          "minLength": 1,
                          "pattern": "^[a-f0-9]{64}$",
                          "type": "string"
                        },
                        "line": {
                          "maximum": 10000000,
                          "minimum": 1,
                          "type": "integer"
                        },
                        "path": {
                          "maxLength": 1024,
                          "minLength": 1,
                          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
                          "type": "string"
                        },
                        "revision": {
                          "maxLength": 128,
                          "minLength": 1,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
                          "type": "string"
                        },
                        "symbol": {
                          "anyOf": [
                            {
                              "maxLength": 128,
                              "minLength": 1,
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "path",
                        "line",
                        "revision",
                        "content_digest",
                        "symbol"
                      ],
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "evidence_id",
                "origin",
                "source",
                "action_digest",
                "contract_id",
                "session_digest",
                "proof_gaps"
              ],
              "type": "object"
            },
            "maxItems": 32,
            "type": "array"
          },
          "schema_version": {
            "const": "ordin.assurance_invariant.v1",
            "type": "string"
          },
          "selectors": {
            "additionalProperties": false,
            "maxProperties": 4,
            "properties": {
              "effects": {
                "items": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
                  "type": "string"
                },
                "maxItems": 64,
                "type": "array"
              },
              "kinds": {
                "items": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
                  "type": "string"
                },
                "maxItems": 32,
                "type": "array"
              },
              "principal": {
                "anyOf": [
                  {
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "resource_ref": {
                "anyOf": [
                  {
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kinds",
              "effects",
              "resource_ref",
              "principal"
            ],
            "type": "object"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "invariant_id",
          "kind",
          "selectors",
          "on_violation",
          "severity",
          "mandatory",
          "authority_ref",
          "provenance"
        ],
        "title": "Ordin assurance invariant v1",
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    },
    "profile_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    },
    "protected_assets": {
      "items": {
        "additionalProperties": false,
        "maxProperties": 4,
        "properties": {
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "path",
              "tool",
              "credential",
              "endpoint",
              "policy"
            ],
            "type": "string"
          },
          "match": {
            "enum": [
              "exact",
              "prefix"
            ],
            "type": "string"
          },
          "value": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "value",
          "match"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    },
    "repository": {
      "additionalProperties": false,
      "maxProperties": 2,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "ordin.assurance_security_profile.v1",
      "type": "string"
    },
    "support_flags": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
        "type": "string"
      },
      "maxItems": 32,
      "type": "array"
    },
    "trust_boundaries": {
      "items": {
        "additionalProperties": false,
        "maxProperties": 3,
        "properties": {
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
            "type": "string"
          },
          "sink": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
            "type": "string"
          },
          "source": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "sink"
        ],
        "type": "object"
      },
      "maxItems": 256,
      "type": "array"
    },
    "version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "repository",
    "protected_assets",
    "trust_boundaries",
    "invariants",
    "support_flags"
  ],
  "title": "Ordin assurance security profile v1",
  "type": "object"
}
