{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latentops.space/ordin/schemas/runtime-request-contract.v1.schema.json",
  "title": "Ordin action-bound request restrictions v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ordin.runtime_request_contract.v1"
    },
    "capability": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "ordin.runtime_capability.v1"
        },
        "contract_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 67,
          "pattern": "^rc:[a-f0-9]{64}$"
        },
        "action_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "action_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "warn",
            "ask",
            "block"
          ]
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical",
            "unknown"
          ]
        },
        "grant_state": {
          "type": "string",
          "enum": [
            "eligible",
            "requires_approval",
            "diagnostic"
          ]
        },
        "filesystem": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "access": {
                "type": "string",
                "enum": [
                  "read",
                  "write",
                  "delete",
                  "metadata",
                  "execute",
                  "unknown"
                ]
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 4096
              },
              "scope": {
                "type": "string",
                "enum": [
                  "exact",
                  "prefix",
                  "unknown"
                ]
              }
            },
            "required": [
              "access",
              "path",
              "scope"
            ],
            "additionalProperties": false
          }
        },
        "network": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*$"
              },
              "port": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 65535
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "rest",
                  "mcp",
                  "json-rpc",
                  "graphql",
                  "websocket",
                  "tcp",
                  "unknown"
                ]
              },
              "access": {
                "type": "string",
                "enum": [
                  "read",
                  "write",
                  "unknown"
                ]
              },
              "methods": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "enum": [
                    "GET",
                    "HEAD",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE",
                    "OPTIONS",
                    "CONNECT",
                    "TRACE"
                  ]
                }
              },
              "paths": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "tool_identity": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "host",
              "port",
              "protocol",
              "access",
              "methods",
              "paths",
              "tool_identity"
            ],
            "additionalProperties": false
          }
        },
        "tools": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "runtime": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "server": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "tool": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "operation": {
                "const": "call",
                "type": "string"
              }
            },
            "required": [
              "runtime",
              "server",
              "tool",
              "operation"
            ],
            "additionalProperties": false
          }
        },
        "process": {
          "type": "object",
          "properties": {
            "execution": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "executables": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "spawn_children": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "execution",
            "executables",
            "spawn_children"
          ],
          "additionalProperties": false
        },
        "privilege": {
          "type": "object",
          "properties": {
            "escalation": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "required_euid": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "escalation",
            "required_euid"
          ],
          "additionalProperties": false
        },
        "credentials": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "binding": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$"
              },
              "host": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*$"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "required": [
              "binding",
              "host",
              "port"
            ],
            "additionalProperties": false
          }
        },
        "unknowns": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "domain": {
                "type": "string",
                "enum": [
                  "filesystem",
                  "network",
                  "process",
                  "privilege",
                  "credential",
                  "tool",
                  "semantics"
                ]
              },
              "reason_code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "domain",
              "reason_code",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "operation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "adapter": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 128
            },
            "effects": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[a-z][a-z0-9_.-]*$"
              }
            },
            "provenance_digest": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "operation",
            "adapter",
            "effects",
            "provenance_digest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "contract_id",
        "action_id",
        "action_digest",
        "decision",
        "risk",
        "grant_state",
        "filesystem",
        "network",
        "tools",
        "process",
        "privilege",
        "credentials",
        "unknowns",
        "source"
      ],
      "additionalProperties": false
    },
    "requests": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "string",
            "enum": [
              "graphql",
              "mcp"
            ]
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*$"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "operation_type": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "query",
              "mutation",
              null
            ]
          },
          "operation_name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128
          },
          "fields": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "server": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "method": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128
          },
          "tool": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128
          },
          "versions": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "enum": [
                "2025-03-26",
                "2025-06-18",
                "2025-11-25"
              ]
            }
          },
          "requires_argument_constraints": {
            "type": "boolean"
          }
        },
        "required": [
          "protocol",
          "host",
          "port",
          "path",
          "operation_type",
          "operation_name",
          "fields",
          "server",
          "method",
          "tool",
          "versions",
          "requires_argument_constraints"
        ],
        "additionalProperties": false
      }
    },
    "request_contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 67,
      "pattern": "^rq:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "capability",
    "requests",
    "request_contract_id"
  ],
  "additionalProperties": false
}
